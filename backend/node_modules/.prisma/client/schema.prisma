generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // swap to "postgresql" + DATABASE_URL for production
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support, so Role/LessonState are plain strings.
// Role: "STUDENT" | "ADMIN"
// LessonState: "NOT_STARTED" | "IN_PROGRESS" | "COMPLETED"

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT")
  avatar       String?
  createdAt    DateTime @default(now())

  lessonProgress  LessonProgress[]
  quarterProgress QuarterProgress[]
  activity        ActivityEntry[]
}

model Chapter {
  id          String   @id @default(cuid())
  name        String
  description String?
  order       Int
  lessons     Lesson[]
}

model Lesson {
  id          String  @id @default(cuid())
  chapterId   String
  chapter     Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title       String
  description String?
  objectives  String // JSON-encoded string[]

  recordings Recording[]
  resources  Resource[]
  progress   LessonProgress[]
}

model Hizb {
  id       String    @id @default(cuid())
  number   Int       @unique
  juz      Int
  title    String
  quarters Quarter[]
}

model Quarter {
  id     String  @id @default(cuid())
  hizbId String
  hizb   Hizb    @relation(fields: [hizbId], references: [id], onDelete: Cascade)
  number Int
  name   String
  notes  String?

  recordings Recording[]
  resources  Resource[]
  progress   QuarterProgress[]
}

model Khutbah {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  description String?
  duration    String?
  audioUrl    String?

  resources Resource[]
}

// Recording/Resource attach to exactly one of lesson/quarter/khutbah.
model Recording {
  id         String   @id @default(cuid())
  title      String
  duration   String?
  uploadedAt DateTime @default(now())
  version    Int      @default(1)
  audioUrl   String?

  lessonId  String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quarterId String?
  quarter   Quarter? @relation(fields: [quarterId], references: [id], onDelete: Cascade)
}

model Resource {
  id         String   @id @default(cuid())
  title      String
  kind       String
  uploadedAt DateTime @default(now())
  fileUrl    String?

  lessonId  String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quarterId String?
  quarter   Quarter? @relation(fields: [quarterId], references: [id], onDelete: Cascade)
  khutbahId String?
  khutbah   Khutbah? @relation(fields: [khutbahId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  target      String    @default("all")
  priority    String    @default("normal") // normal | important
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
}

model LessonProgress {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status   String @default("NOT_STARTED")

  @@unique([userId, lessonId])
}

model QuarterProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quarterId   String
  quarter     Quarter  @relation(fields: [quarterId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, quarterId])
}

model ActivityEntry {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refId  String // id of recording/khutbah listened to
  title  String
  kind   String   @default("استماع")
  date   DateTime @default(now())
}
