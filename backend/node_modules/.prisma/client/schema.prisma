generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Role: "STUDENT" | "ADMIN"

enum DayType {
  FIXED
  OPTIONAL
  NONE
}

enum LessonTag {
  TAJWEED
  IQRAA
}

model WeeklyScheduleTemplate {
  id        Int        @id @default(autoincrement())
  dayOfWeek Int // 0=Sunday ... 6=Saturday
  dayType   DayType
  lessonTag LessonTag?
  startTime String?
  endTime   String?
  updatedAt DateTime   @updatedAt

  @@unique([dayOfWeek])
}

model ScheduleException {
  id          Int        @id @default(autoincrement())
  date        DateTime   @db.Date
  isCancelled Boolean    @default(false)
  isAdded     Boolean    @default(false)
  lessonTag   LessonTag?
  startTime   String?
  endTime     String?
  note        String?
  createdAt   DateTime   @default(now())

  @@unique([date])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         String   @default("STUDENT")
  avatar       String?
  tokenVersion Int      @default(0)
  provider     String?
  googleId     String?  @unique
  facebookId   String?  @unique
  createdAt    DateTime @default(now())

  lessonProgress  LessonProgress[]
  quarterProgress QuarterProgress[]
  activity        ActivityEntry[]
}

model Chapter {
  id          String   @id @default(cuid())
  name        String
  description String?
  order       Int
  lessons     Lesson[]

  @@unique([order])
}

model Lesson {
  id          String  @id @default(cuid())
  chapterId   String
  chapter     Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title       String
  description String?
  objectives  String

  recordings Recording[]
  resources  Resource[]
  progress   LessonProgress[]
}

model Hizb {
  id       String    @id @default(cuid())
  number   Int       @unique
  juz      Int
  title    String
  quarters Quarter[]
}

model Quarter {
  id     String  @id @default(cuid())
  hizbId String
  hizb   Hizb    @relation(fields: [hizbId], references: [id], onDelete: Cascade)
  number Int
  name   String
  notes  String?

  recordings Recording[]
  resources  Resource[]
  progress   QuarterProgress[]

  @@unique([hizbId, number])
}

model Khutbah {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  description String?
  duration    String?
  audioUrl    String?

  resources  Resource[]
  recordings Recording[]
}

model Recording {
  id           String   @id @default(cuid())
  title        String
  kind         String   @default("audio")
  duration     String?
  uploadedAt   DateTime @default(now())
  version      Int      @default(1)
  audioUrl     String?
  cloudinaryId String?

  lessonId  String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quarterId String?
  quarter   Quarter? @relation(fields: [quarterId], references: [id], onDelete: Cascade)
  khutbahId String?
  khutbah   Khutbah? @relation(fields: [khutbahId], references: [id], onDelete: Cascade)
}

model Resource {
  id           String   @id @default(cuid())
  title        String
  kind         String
  uploadedAt   DateTime @default(now())
  fileUrl      String?
  cloudinaryId String?

  lessonId  String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  quarterId String?
  quarter   Quarter? @relation(fields: [quarterId], references: [id], onDelete: Cascade)
  khutbahId String?
  khutbah   Khutbah? @relation(fields: [khutbahId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  target      String    @default("all")
  priority    String    @default("normal")
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  resolvedAt  DateTime?
}

model LessonProgress {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status   String @default("NOT_STARTED")

  @@unique([userId, lessonId])
}

model QuarterProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quarterId   String
  quarter     Quarter  @relation(fields: [quarterId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, quarterId])
}

model ActivityEntry {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refId  String
  title  String
  kind   String   @default("استماع")
  date   DateTime @default(now())
}

model MediaCleanupJob {
  id           String    @id @default(cuid())
  fileUrl      String?
  cloudinaryId String?
  attempts     Int       @default(0)
  lastError    String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
}
