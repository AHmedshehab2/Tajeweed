# Local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tajeweed"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tajeweed"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
HOST=0.0.0.0
CLIENT_ORIGIN="http://localhost:4000"

# Bootstrap: anyone who registers with this email gets ADMIN role (optional)
ADMIN_BOOTSTRAP_EMAIL="tajeweed@gmail.com"

# Seed passwords (optional — random passwords are generated and printed if unset)
SEED_STUDENT_PASSWORD=""
SEED_ADMIN_PASSWORD=""

# Supabase — https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL="https://supabase.com/dashboard/project/oqfsdttzddjgxhtahtui"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth — https://developers.facebook.com/apps
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Cloudflare R2 (optional for local development; required on Render)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://media.example.com"

# Production: use PostgreSQL everywhere. docker-compose.yml / docker-compose.prod.yml
# bundle a postgres:16 service (DATABASE_URL points at it). On Render, set DATABASE_URL
# to your managed PostgreSQL connection string (Render Postgres or external provider).
# NODE_ENV=production
# CLIENT_ORIGIN="https://your-domain.com"  # Required in production
# REQUIRE_R2_STORAGE="true"  # Required for Render or any ephemeral filesystem host
# ALLOW_PROD_SEED="true"  # Only set when you intentionally re-seed production
