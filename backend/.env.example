# Local development
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
HOST=0.0.0.0
CLIENT_ORIGIN="http://localhost:4000"

# Bootstrap: anyone who registers with this email gets ADMIN role (optional)
ADMIN_BOOTSTRAP_EMAIL="tajeweed@gmail.com"

# Seed passwords (optional — random passwords are generated and printed if unset)
SEED_STUDENT_PASSWORD=""
SEED_ADMIN_PASSWORD=""

# Supabase — https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL="https://supabase.com/dashboard/project/oqfsdttzddjgxhtahtui"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Facebook OAuth — https://developers.facebook.com/apps
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Production (Docker uses file:./data/prod.db via docker-compose.yml)
# NODE_ENV=production
# CLIENT_ORIGIN="https://your-domain.com"  # Required in production
# ALLOW_PROD_SEED="true"  # Only set when you intentionally re-seed production
